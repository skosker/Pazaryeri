DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prosinta?schema=public"

# NextAuth
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# iyzico payment infrastructure (sandbox). Leave the placeholder values to run
# the app in MOCK payment mode (no real iyzico account required for local dev).
# Get real sandbox keys at https://merchant.iyzipay.com (Sandbox panel).
IYZICO_API_KEY="sandbox-mock"
IYZICO_SECRET_KEY="sandbox-mock"
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend (transactional email). Leave unset to log emails to the console instead
# of sending them.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Prosinta <onboarding@resend.dev>"

# Bank account shown on the "Havale/EFT ile Öde" checkout tab. In production this lives
# in the database and is edited at /admin/banka; these are only a local-development
# fallback for when that row does not exist yet. Leave empty to use the built-in values.
BANK_ACCOUNT_HOLDER=""
BANK_IBAN=""
BANK_NAME=""

# Notified when a buyer reports a bank transfer, so an ADMIN-role user can
# verify and confirm it from /admin. Optional.
ADMIN_EMAIL=""

# Pexels (ilan kapak fotoğrafları ve freelancer profil fotoğrafları). Ücretsiz anahtar:
# https://www.pexels.com/api/ — boş bırakılırsa kapaklar çizimle, profiller çizilen
# avatarla görünür. Admin panelinden /admin/kapaklar ve /admin/profil-fotograflari
# ekranlarıyla çalıştırılır.
PEXELS_API_KEY=""

# Vercel Blob (ilan kapak görselleri). Boş bırakılırsa görseller Postgres'e
# yazılır ve /api/gorsel/<id> üzerinden servis edilir; ek kurulum gerekmez.
# Üretimde CDN'den servis için Vercel panelinden bir Blob store açıp token'ı buraya ekle.
BLOB_READ_WRITE_TOKEN=

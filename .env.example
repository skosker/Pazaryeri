DATABASE_URL="postgresql://postgres:postgres@localhost:5432/profestia?schema=public"

# NextAuth
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# iyzico payment infrastructure (sandbox). Leave the placeholder values to run
# the app in MOCK payment mode (no real iyzico account required for local dev).
# Get real sandbox keys at https://merchant.iyzipay.com (Sandbox panel).
IYZICO_API_KEY="sandbox-mock"
IYZICO_SECRET_KEY="sandbox-mock"
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend (transactional email). Leave unset to log emails to the console instead
# of sending them.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Profestia <onboarding@resend.dev>"

# Bank account shown on the "Havale/EFT ile Öde" checkout tab.
BANK_ACCOUNT_HOLDER="Profestia Demo Hesap"
BANK_IBAN="TR00 0000 0000 0000 0000 0000 00"
BANK_NAME="Demo Banka"

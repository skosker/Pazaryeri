// Profestia - Prisma schema
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  BUYER
  FREELANCER
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  PENDING_VERIFICATION
  PAID
  IN_PROGRESS
  DELIVERED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  INITIALIZED
  SUCCESS
  FAILED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(BUYER)
  title         String? // e.g. "Grafik Tasarımcı" shown under name for freelancers
  // Payout details. The holder name is stored separately because banks reject a
  // transfer when it does not match the account, and it is often not the display name.
  iban          String?
  ibanHolder    String?
  bio           String?
  image         String?
  emailVerified DateTime?
  suspended     Boolean   @default(false)
  isOnline      Boolean   @default(false)
  // Meaning depends on role: BUYER = Profestia Pro member, FREELANCER = admin-verified Pro freelancer.
  isPro         Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  gigs               Gig[]               @relation("SellerGigs")
  payouts            Payout[]            @relation("SellerPayouts")
  ordersMade         Order[]             @relation("BuyerOrders")
  reviews            Review[]            @relation("BuyerReviews")
  verificationTokens VerificationToken[]

  @@map("users")
}

model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification_tokens")
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  icon  String @default("sparkles")
  order Int    @default(0)

  gigs           Gig[]
  subcategories  Subcategory[]

  @@map("categories")
}

model Subcategory {
  id   String @id @default(cuid())
  name String
  slug String @unique

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  gigs Gig[]

  @@index([categoryId])
  @@map("subcategories")
}

model Gig {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  coverColor  String   @default("indigo") // gradient fallback shown when there is no cover
  coverImage  String? // seller-uploaded cover: a Blob CDN URL, or /api/gorsel/<id> when stored in Postgres
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sellerId   String
  seller     User     @relation("SellerGigs", fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])

  packages Package[]
  orders   Order[]
  reviews  Review[]

  @@index([categoryId])
  @@index([sellerId])
  @@index([subcategoryId])
  @@map("gigs")
}

enum PackageTier {
  STANDARD
  BASIC
  PREMIUM
}

model Package {
  id            String      @id @default(cuid())
  tier          PackageTier @default(STANDARD)
  name          String      @default("Standart Paket")
  description   String
  price         Decimal     @db.Decimal(10, 2)
  deliveryDays  Int
  revisionCount Int         @default(2)
  features      String[]    @default([])

  gigId String
  gig   Gig    @relation(fields: [gigId], references: [id], onDelete: Cascade)

  orders Order[]

  @@index([gigId])
  @@map("packages")
}

model Order {
  id              String      @id @default(cuid())
  status          OrderStatus @default(PENDING_PAYMENT)
  amount          Decimal     @db.Decimal(10, 2)
  escrowReleased  Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  buyerId String
  buyer   User   @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Cascade)

  gigId String
  gig   Gig    @relation(fields: [gigId], references: [id])

  packageId String
  package   Package @relation(fields: [packageId], references: [id])

  payment Payment?
  review  Review?
  payout  Payout?

  @@index([buyerId])
  @@index([gigId])
  @@map("orders")
}

model Payment {
  id             String        @id @default(cuid())
  provider       String        @default("iyzico")
  status         PaymentStatus @default(INITIALIZED)
  conversationId String        @unique
  token          String?
  paymentId      String?
  rawResponse    Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  gigId String
  gig   Gig    @relation(fields: [gigId], references: [id], onDelete: Cascade)

  buyerId String
  buyer   User   @relation("BuyerReviews", fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([gigId])
  @@map("reviews")
}

// Fallback image store used when no BLOB_READ_WRITE_TOKEN is configured, so
// uploads work with nothing but DATABASE_URL. Served by /api/gorsel/[id].
model UploadedImage {
  id        String   @id @default(cuid())
  mimeType  String
  data      Bytes
  size      Int
  createdAt DateTime @default(now())

  @@map("uploaded_images")
}


enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

/// One payable row per completed order. Amounts are stored split so a commission can
/// be introduced later without recomputing history: today commission is 0 and net
/// equals gross.
model Payout {
  id         String       @id @default(cuid())
  status     PayoutStatus @default(PENDING)
  gross      Decimal      @db.Decimal(10, 2)
  commission Decimal      @default(0) @db.Decimal(10, 2)
  net        Decimal      @db.Decimal(10, 2)
  // Copied at creation: the seller may edit their profile later, but a transfer that
  // already went out must keep the details it was actually sent to.
  iban       String?
  ibanHolder String?
  note       String?
  paidAt     DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  sellerId String
  seller   User   @relation("SellerPayouts", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([status])
  @@map("payouts")
}

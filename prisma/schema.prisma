// Prosinta - Prisma schema
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  BUYER
  FREELANCER
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  PENDING_VERIFICATION
  PAID
  IN_PROGRESS
  DELIVERED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  INITIALIZED
  SUCCESS
  FAILED
}

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  passwordHash       String
  role               Role      @default(BUYER)
  title              String? // e.g. "Grafik Tasarımcı" shown under name for freelancers
  // Payout details. The holder name is stored separately because banks reject a
  // transfer when it does not match the account, and it is often not the display name.
  iban               String?
  ibanHolder         String?
  bio                String?
  image              String?
  // A freshly uploaded photo an automated check flagged as possibly inappropriate sits
  // here — not in `image` — until an admin clears or rejects it, so the public-facing
  // avatar never shows unreviewed content. NULL means there is nothing awaiting review;
  // an upload the check does not flag (or cannot check, e.g. no API key configured)
  // goes straight into `image` and never touches these two fields.
  pendingImage       String?
  photoFlagReason    String?
  // Freelancer profile details: shown on the profile page and used by the directory
  // filters. Nullable because buyers and older accounts never filled them in.
  city               String?
  age                Int?
  /// Uzmanlık: what this freelancer actually does, a handful of short labels.
  skills             String[]  @default([])
  /// Generated showcase profile rather than a real sign-up. The generator only ever
  /// writes rows carrying this flag, so re-running it cannot touch a real account.
  synthetic          Boolean   @default(false)
  emailVerified      DateTime?
  suspended          Boolean   @default(false)
  isOnline           Boolean   @default(false)
  /// Yalnızca elle içe aktarılan alıcılar için: admin listesinde gösterilen sipariş
  /// sayısı (ismin ham listede kaç kez geçtiği). Gerçek Order kaydı değildir; diğer
  /// kullanıcılarda NULL kalır ve sipariş sayısı gerçek kayıtlardan gelir.
  importedOrderCount Int?
  /// Süresiz Pro: aylık/yıllık üyelikten önce tek seferlik ödemeyle Pro olanlar ve
  /// admin'in elle Pro yaptıkları. Süreli üyelik proUntil/proPlus'ta; etkin üyelik
  /// ikisinden hesaplanır (src/lib/membership.ts).
  isPro              Boolean   @default(false)
  /// Ücretli (ya da deneme) üyeliğin bittiği an; geçmişte kalınca üyelik düşer.
  proUntil           DateTime?
  /// proUntil'e kadar olan dönem Pro Plus mı (değilse Pro).
  proPlus            Boolean   @default(false)
  /// Ücretsiz Pro denemesini kullandığı an (kişi başına bir kez).
  proTrialUsedAt     DateTime?
  /// Bitiş hatırlatmasının gönderildiği proUntil (aynı dönem için ikinci e-posta gitmesin).
  proReminderFor     DateTime?
  /// Kampanya ve fırsat duyurusu e-postaları; e-postadaki bağlantıyla ya da Profilim'den kapatılır.
  campaignEmails     Boolean   @default(true)
  /// Kurumsal abonelik (KURUMSAL / KURUMSAL_PLUS) ve bittiği an; geçmişte kalınca düşer.
  corpPlan           MembershipPlan?
  corpPlanUntil      DateTime?
  corpReminderFor    DateTime?
  /// Kurucu Freelancer sırası (1'den kontenjana kadar, /admin/ayarlar): ilk ilanı onaylanan ilk gerçek freelancer'lara
  /// bir kez verilir ve kalıcıdır. Diğer herkes için NULL.
  founderNumber      Int?      @unique
  /// Kurumsal hesap fatura bilgileri (alıcı kayıtta "Kurumsal" seçerse ya da Profil'den
  /// girer). Bireysel hesaplarda hepsi NULL; companyName dolu olan hesap kurumsaldır.
  /// Kişisel davet kodu (prosinta.com/davet/<kod>); ilk kez Davet Et sayfası açılınca üretilir.
  referralCode       String?   @unique
  /// Bu kullanıcıyı davet eden (kayıt sırasında davet bağlantısıyla geldiyse).
  referredById       String?
  referredBy         User?     @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals          User[]    @relation("Referrals")
  referralRewards    ReferralReward[] @relation("RewardsEarned")
  referralRewardFor  ReferralReward?  @relation("RewardSource")
  companyName        String?
  taxOffice          String?
  /// 10 haneli VKN ya da şahıs şirketi için 11 haneli TCKN.
  taxNumber          String?
  /// Açık adres (mahalle, cadde, no); il ve ilçe ayrı alanlarda, listeden seçilir.
  billingAddress     String?
  billingCity        String?
  billingDistrict    String?
  /// Freelancer'ın isteğe bağlı T.C. kimlik numarası: komisyon faturası adına kesilsin diye.
  /// Yalnızca kendisi ve admin görür.
  tckn               String?
  /// Kurumsal bakiye (TL): Havale/EFT ile yüklenir, siparişlerde harcanır. Her hareket
  /// BalanceEntry'de kayıtlı; bu alan onların toplamıdır.
  balance            Decimal   @default(0) @db.Decimal(12, 2)
  balanceTopUps      BalanceTopUp[]
  balanceEntries     BalanceEntry[]
  founderAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  gigs                  Gig[]                @relation("SellerGigs")
  payouts               Payout[]             @relation("SellerPayouts")
  ordersMade            Order[]              @relation("BuyerOrders")
  reviews               Review[]             @relation("BuyerReviews")
  verificationTokens    VerificationToken[]
  passwordResets        PasswordResetToken[]
  proPurchases          ProPurchase[]
  gigBoosts             GigBoost[]
  conversationsAsBuyer  Conversation[]       @relation("BuyerConversations")
  conversationsAsSeller Conversation[]       @relation("SellerConversations")
  messagesSent          Message[]            @relation("SentMessages")

  @@index([role, synthetic])
  @@map("users")
}

model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification_tokens")
}

/**
 * Password reset links. Kept apart from VerificationToken on purpose: those are handed
 * out at signup and live for a day, and if one table served both, a stale sign-up link
 * would be enough to set someone's password.
 * Only the SHA-256 of the token is stored, so the rows are useless to anyone who reads
 * the table — the usable half exists solely in the email that was sent.
 */
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  icon  String @default("sparkles")
  order Int    @default(0)

  gigs          Gig[]
  subcategories Subcategory[]

  @@map("categories")
}

model Subcategory {
  id   String @id @default(cuid())
  name String
  slug String @unique

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  gigs Gig[]

  @@index([categoryId])
  @@map("subcategories")
}

model Gig {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  description     String
  coverColor      String    @default("indigo") // gradient fallback shown when there is no cover
  coverImage      String? // seller-uploaded cover: a Blob CDN URL, or /api/gorsel/<id> when stored in Postgres
  /// "Örnek işler": a handful of the seller's own past-work images, shown on the gig page.
  /// Same URL shape as coverImage. Most useful before a gig has any reviews.
  portfolioImages String[]  @default([])
  published       Boolean   @default(true)
  /// Admin-curated "Editör Seçkisi" badge — set by hand from /admin/ilanlar, not earned
  /// automatically, so it stays meaningful rather than something every gig ends up with.
  featured        Boolean   @default(false)
  // Moderation state, separate from `published`: a freelancer can pause/resume an
  // approved gig freely (that only touches `published`), but a brand-new submission
  // starts PENDING and stays invisible everywhere `published: true` is required until
  // an admin approves it. Defaults to APPROVED so every existing row and every
  // generator/seed script that inserts a gig without mentioning this column keeps
  // publishing immediately, exactly as before — only the real freelancer-facing
  // "create gig" action opts a row into PENDING.
  status          GigStatus @default(APPROVED)
  /// Paid "Öne Çıkar": while this is in the future the gig leads the default listing with
  /// a "Sponsorlu" label. Each paid GigBoost pushes it forward by its days.
  sponsoredUntil  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sellerId   String
  seller     User     @relation("SellerGigs", fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])

  packages Package[]
  orders   Order[]
  reviews  Review[]
  boosts   GigBoost[]
  campaignEntries CampaignEntry[]

  @@index([categoryId])
  @@index([sellerId])
  @@index([subcategoryId])
  @@map("gigs")
}

enum GigStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PackageTier {
  STANDARD
  BASIC
  PREMIUM
}

model Package {
  id            String      @id @default(cuid())
  tier          PackageTier @default(STANDARD)
  name          String      @default("Standart Paket")
  description   String
  price         Decimal     @db.Decimal(10, 2)
  deliveryDays  Int
  revisionCount Int         @default(2)
  features      String[]    @default([])

  gigId String
  gig   Gig    @relation(fields: [gigId], references: [id], onDelete: Cascade)

  orders Order[]

  @@index([gigId])
  @@map("packages")
}

model Order {
  id                      String      @id @default(cuid())
  status                  OrderStatus @default(PENDING_PAYMENT)
  /// The package price: what the seller's payout is computed from.
  amount                  Decimal     @db.Decimal(10, 2)
  /// First-order discount Prosinta absorbs: the buyer pays amount − discount, the seller
  /// is still paid on the full amount. 0 for every other order.
  discount                Decimal     @default(0) @db.Decimal(10, 2)
  /// Davet ödülünden düşülen tutar (Prosinta karşılar): alıcı amount − discount −
  /// creditDiscount öder, satıcının hakedişi yine amount üzerinden hesaplanır.
  creditDiscount          Decimal     @default(0) @db.Decimal(10, 2)
  /// Kurumsal abonelik indirimi (Prosinta karşılar, aylık üst sınırlı); satıcının hakedişi
  /// yine amount üzerinden.
  corporateDiscount       Decimal     @default(0) @db.Decimal(10, 2)
  referralReward          ReferralReward? @relation("RewardUsedOn")
  escrowReleased          Boolean     @default(false)
  /// Free revisions used against the package's revisionCount (see buyerRequestRevision).
  revisionsUsed           Int         @default(0)
  /// Set when the buyer asks to cancel a PAID order — per the site's iptal/iade policy this
  /// goes through support rather than an automatic refund, so it is a flag for that
  /// conversation, not a status change.
  cancellationRequestedAt DateTime?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  buyerId String
  buyer   User   @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Cascade)

  gigId String
  gig   Gig    @relation(fields: [gigId], references: [id])

  packageId String
  package   Package @relation(fields: [packageId], references: [id])

  payment Payment?
  review  Review?
  payout  Payout?

  @@index([buyerId])
  @@index([gigId])
  @@map("orders")
}

model Payment {
  id             String        @id @default(cuid())
  provider       String        @default("paytr")
  status         PaymentStatus @default(INITIALIZED)
  conversationId String        @unique
  token          String?
  paymentId      String?
  rawResponse    Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

/**
 * A one-off Pro upgrade purchase — the same PayTR flow as Payment, but for a user
 * account rather than an Order, so it is its own table instead of forcing Payment's
 * required, unique orderId to become optional. The purchase's own id doubles as the
 * PayTR merchant_oid (see src/lib/pro-purchase.ts), so there is no separate
 * conversationId column to keep in step with it.
 */
model ProPurchase {
  id          String        @id @default(cuid())
  provider    String        @default("paytr")
  status      PaymentStatus @default(INITIALIZED)
  amount      Decimal       @db.Decimal(10, 2)
  plan        MembershipPlan @default(PRO)
  /// 1 = aylık, 12 = yıllık. NULL: eski tek seferlik (süresiz) Pro satın alması.
  months      Int?
  /// Ön Bilgilendirme Formu ve Mesafeli Hizmet Sözleşmesi'nin onaylandığı an (ödemeden önce zorunlu).
  termsAcceptedAt DateTime?
  /// Bu satış için Prosinta'nın kestiği fatura (Admin → Faturalar); kesilene kadar NULL.
  invoiceNo   String?
  invoicedAt  DateTime?
  token       String?
  rawResponse Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("pro_purchases")
}

enum MembershipPlan {
  PRO
  PRO_PLUS
  /// Kurumsal abonelik paketleri (alıcı tarafı, şirket hesapları).
  KURUMSAL
  KURUMSAL_PLUS
}

/// One paid "Öne Çıkar" purchase for a gig — same payment shape as ProPurchase (its id
/// is the PayTR merchant_oid; a bank transfer waits INITIALIZED with provider "havale"
/// until an admin confirms it).
model GigBoost {
  id          String        @id @default(cuid())
  provider    String        @default("paytr")
  status      PaymentStatus @default(INITIALIZED)
  amount      Decimal       @db.Decimal(10, 2)
  days        Int
  token       String?
  rawResponse Json?
  activatedAt DateTime?
  /// Üyelikle gelen aylık ücretsiz Öne Çıkar hakkı ("2026-10"); ücretli satın almada NULL.
  /// Kullanıcı başına ayda bir tane olabilir.
  creditMonth String?
  /// Ön Bilgilendirme Formu ve Mesafeli Hizmet Sözleşmesi'nin onaylandığı an (ücretli alımda zorunlu).
  termsAcceptedAt DateTime?
  /// Bu satış için Prosinta'nın kestiği fatura (Admin → Faturalar); kesilene kadar NULL.
  invoiceNo   String?
  invoicedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  gigId  String
  gig    Gig    @relation(fields: [gigId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, creditMonth])
  @@index([gigId])
  @@index([userId])
  @@map("gig_boosts")
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  gigId String
  gig   Gig    @relation(fields: [gigId], references: [id], onDelete: Cascade)

  buyerId String
  buyer   User   @relation("BuyerReviews", fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([gigId])
  @@map("reviews")
}

// Fallback image store used when no BLOB_READ_WRITE_TOKEN is configured, so
// uploads work with nothing but DATABASE_URL. Served by /api/gorsel/[id].
model UploadedImage {
  id        String   @id @default(cuid())
  mimeType  String
  data      Bytes
  size      Int
  createdAt DateTime @default(now())

  @@map("uploaded_images")
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

/// One payable row per completed order. Amounts are stored split so a commission can
/// be introduced later without recomputing history: today commission is 0 and net
/// equals gross.
model Payout {
  id         String       @id @default(cuid())
  status     PayoutStatus @default(PENDING)
  gross      Decimal      @db.Decimal(10, 2)
  commission Decimal      @default(0) @db.Decimal(10, 2)
  net        Decimal      @db.Decimal(10, 2)
  // Copied at creation: the seller may edit their profile later, but a transfer that
  // already went out must keep the details it was actually sent to.
  iban       String?
  ibanHolder String?
  note       String?
  paidAt     DateTime?
  /// Komisyon faturası (Prosinta → freelancer); kesilene kadar NULL.
  invoiceNo  String?
  invoicedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  sellerId String
  seller   User   @relation("SellerPayouts", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([status])
  @@map("payouts")
}

/// Havale/EFT ile ödeyen alıcıya gösterilen şirket tahsilat hesapları. Birden çok olabilir:
/// admin panelinden eklenip çıkarılır, ödeme sayfası hepsini listeler (alıcı kendi
/// bankasına denk geleni seçip masrafsız EFT yapabilsin). Hiç satır yoksa ortam
/// değişkenleri, o da yoksa koddaki değerler tek hesap olarak gösterilir.
model BankAccount {
  id            String   @id @default(cuid())
  accountHolder String
  bankName      String
  iban          String
  /// Pasife alınan hesap ödeme sayfasında gösterilmez ama silinmez — admin panelinde
  /// kalır, istenirse tekrar aktif edilebilir.
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("bank_accounts")
}

/// Freelancer hakediş IBAN kayıtları — yalnızca admin panelinde görüntülenir, herkese
/// açık değildir. Ayrı bir tabloda tutulur ki dizinde/profillerde görünmesin.
model FreelancerIban {
  id        String   @id @default(cuid())
  name      String
  iban      String
  createdAt DateTime @default(now())

  @@map("freelancer_ibans")
}

/// Freelancer'lara yapılan hakediş ödemeleri — yalnızca admin panelinde görünür. Payout
/// modeli sipariş+satıcıya zorunlu bağlı olduğu için, dış (elle) ödemeler bu ayrı tabloda
/// tutulur: ad, IBAN, tutar ve ödeme tarihi.
model FreelancerPayout {
  id        String   @id @default(cuid())
  name      String
  iban      String
  amount    Decimal  @db.Decimal(12, 2)
  paidAt    DateTime
  createdAt DateTime @default(now())

  @@index([paidAt])
  @@map("freelancer_payouts")
}

/// One thread per (buyer, seller) pair — the same two people talking about a second gig
/// keep the history they already have. The buyer is whoever contacted the freelancer;
/// a freelancer never opens a thread with someone who has not ordered from them.
model Conversation {
  id               String    @id @default(cuid())
  buyerId          String
  buyer            User      @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId         String
  seller           User      @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  lastMessageAt    DateTime  @default(now())
  /// A side has unread messages while lastMessageAt is later than its lastReadAt. The
  /// sender's own lastReadAt moves with every message it sends, so it never counts its
  /// own messages as unread.
  buyerLastReadAt  DateTime?
  sellerLastReadAt DateTime?
  /// When each side was last emailed about unread messages: a new email goes out only
  /// once they have read the thread since, so a burst of messages is one email.
  buyerNotifiedAt  DateTime?
  sellerNotifiedAt DateTime?
  createdAt        DateTime  @default(now())
  messages         Message[]

  @@unique([buyerId, sellerId])
  @@index([buyerId, lastMessageAt])
  @@index([sellerId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  /// Stored already masked: contact details (phone, e-mail, IBAN, messenger links) are
  /// replaced before saving, per the membership agreement's ban on taking deals off the
  /// platform (7.1–7.2), so the original never reaches the other side.
  body           String
  /// What was masked out, if anything — the queue an admin reviews.
  maskedReason   String?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@map("messages")
}

/// Campaign and membership settings edited at /admin/ayarlar. A single row (id 1); until
/// an admin saves the form there is no row and the column defaults below apply.
model SiteSettings {
  id                 Int      @id @default(1)
  /// Üyelik paketleri (yalnızca freelancer'lar): aylık fiyatlar; yıllıkta indirim yüzdesi.
  proMonthlyTl       Decimal  @default(1000) @db.Decimal(10, 2)
  plusMonthlyTl      Decimal  @default(1250) @db.Decimal(10, 2)
  yearlyDiscountPercent Decimal @default(20) @db.Decimal(5, 2)
  proTrialEnabled    Boolean  @default(false)
  proTrialDays       Int      @default(30)
  /// Her ay üyelikle gelen ücretsiz Öne Çıkar süresi (gün).
  proFreeBoostDays   Int      @default(3)
  plusFreeBoostDays  Int      @default(10)
  /// Pro Plus üyelerin Öne Çıkar satın alırken aldığı indirim, yüzde.
  plusBoostDiscountPercent Decimal @default(25) @db.Decimal(5, 2)
  portfolioImages    Int      @default(5)
  portfolioImagesPro Int      @default(12)
  portfolioImagesPlus Int     @default(20)
  boostEnabled       Boolean  @default(true)
  boostPriceTl       Decimal  @default(1000) @db.Decimal(10, 2)
  boostDays          Int      @default(30)
  /// Hakedişten kesilen komisyon, yüzde olarak (2.5 = %2,5).
  commissionPercent  Decimal  @default(2.5) @db.Decimal(5, 2)
  /// Prosinta'nın kendi satışlarında (fiyatlar KDV dahil) faturadaki KDV oranı.
  vatPercent         Decimal  @default(20) @db.Decimal(5, 2)
  founderEnabled     Boolean  @default(true)
  founderLimit       Int      @default(5000)
  /// İlk sipariş indirimi: yüzde, en fazla bu kadar TL. Prosinta karşılar.
  firstOrderEnabled  Boolean  @default(true)
  firstOrderPercent  Decimal  @default(5) @db.Decimal(5, 2)
  firstOrderMaxTl    Decimal  @default(500) @db.Decimal(10, 2)
  /// Davet programı: davet edilenin ilk siparişi tamamlanınca davet edene bu kadar TL.
  referralEnabled    Boolean  @default(true)
  referralRewardTl   Decimal  @default(200) @db.Decimal(10, 2)
  /// Kurumsal paket: toplu bakiye yükleme ve bakiyeyle ödeme (yalnızca kurumsal hesaplar).
  corporateEnabled      Boolean @default(false)
  /// Kurumsal abonelik paketleri (Kurumsal / Kurumsal Plus); kapalıyken kimse görmez.
  corporatePlansEnabled Boolean @default(false)
  corpMonthlyTl         Decimal @default(1500) @db.Decimal(10, 2)
  corpPlusMonthlyTl     Decimal @default(3500) @db.Decimal(10, 2)
  /// Siparişlerde indirim yüzdesi ve aylık üst sınırı (TL); Prosinta karşılar.
  corpOrderDiscountPercent     Decimal @default(3) @db.Decimal(5, 2)
  corpOrderDiscountMaxTl       Decimal @default(1000) @db.Decimal(10, 2)
  corpPlusOrderDiscountPercent Decimal @default(5) @db.Decimal(5, 2)
  corpPlusOrderDiscountMaxTl   Decimal @default(3000) @db.Decimal(10, 2)
  /// Bakiye yüklemede pakete göre bonus yüzdesi.
  corpTopUpBonusPercent        Decimal @default(1) @db.Decimal(5, 2)
  corpPlusTopUpBonusPercent    Decimal @default(2) @db.Decimal(5, 2)
  corporateMinTopUpTl   Decimal @default(5000) @db.Decimal(10, 2)
  /// Yüklemeye eklenen bonus, yüzde (ör. 3 = %3). 0 = bonus yok.
  corporateBonusPercent Decimal @default(0) @db.Decimal(5, 2)
  updatedAt          DateTime @updatedAt

  @@map("site_settings")
}

/// Bir davet ödülü: davet edilen kullanıcının (referredUser) ilk siparişi tamamlanınca
/// davet edene (referrer) verilir, kişi başına bir kez. usedOrderId, ödülün düşüldüğü
/// siparişi gösterir; o sipariş hâlâ ödenmemişse ya da iptal edildiyse ödül yeniden
/// kullanılabilir sayılır.
model ReferralReward {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  referrerId     String
  referrer       User   @relation("RewardsEarned", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUserId String @unique
  referredUser   User   @relation("RewardSource", fields: [referredUserId], references: [id], onDelete: Cascade)
  /// Ödülü kazandıran (davet edilenin tamamlanan ilk) sipariş.
  sourceOrderId  String

  usedOrderId String? @unique
  usedOrder   Order?  @relation("RewardUsedOn", fields: [usedOrderId], references: [id], onDelete: SetNull)

  @@index([referrerId])
  @@map("referral_rewards")
}

/// A corporate account's bank-transfer top-up request; an admin confirms it once the
/// money is in, which credits amount + bonus to the balance.
model BalanceTopUp {
  id          String        @id @default(cuid())
  status      PaymentStatus @default(INITIALIZED)
  amount      Decimal       @db.Decimal(12, 2)
  bonus       Decimal       @default(0) @db.Decimal(12, 2)
  confirmedAt DateTime?
  createdAt   DateTime      @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("balance_top_ups")
}

enum BalanceEntryKind {
  TOPUP
  ORDER
  ADJUSTMENT
  /// Kurumsal abonelik bakiyeden ödendi.
  PLAN
}

/// Every change to a corporate balance: + for a confirmed top-up, − for an order paid.
model BalanceEntry {
  id        String           @id @default(cuid())
  kind      BalanceEntryKind
  amount    Decimal          @db.Decimal(12, 2)
  note      String?
  orderId   String?          @unique
  topUpId   String?          @unique
  /// Bakiyeden ödenen abonelik satın alması (ProPurchase); aynı satın alma iki kez düşülmesin.
  purchaseId String?         @unique
  createdAt DateTime         @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("balance_entries")
}

/// A seasonal campaign (Freelancer Günü, Efsane Cuma…), created and edited at
/// /admin/kampanyalar. Switched off it is invisible to everyone but admins. Switched on,
/// freelancers can sign gigs up until it ends; buyers see the discounts only between
/// start and end. It can also discount Pro and "Öne Çıkar" for freelancers while live.
model Campaign {
  id                   String   @id @default(cuid())
  name                 String
  /// Short line under the name on the campaign page.
  tagline              String?
  enabled              Boolean  @default(false)
  start                DateTime
  end                  DateTime
  minPercent           Int      @default(10)
  maxPercent           Int      @default(50)
  proDiscountPercent   Int      @default(0)
  boostDiscountPercent Int      @default(0)
  /// Freelancer'lara duyuru e-postasının gittiği an ve kaç kişiye gittiği (kampanya başına bir kez).
  announcedAt          DateTime?
  announcedCount       Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  entries CampaignEntry[]

  @@map("campaigns")
}

/// A gig's sign-up to a campaign with the discount its freelancer chose (they carry it).
model CampaignEntry {
  percent   Int
  createdAt DateTime @default(now())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  gigId      String
  gig        Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)

  @@id([campaignId, gigId])
  @@index([gigId])
  @@map("campaign_entries")
}
